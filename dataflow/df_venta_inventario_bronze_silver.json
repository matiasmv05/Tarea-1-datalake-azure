{
	"name": "df_venta_inventario_bronze_silver",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "inventacion_xlsx",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_scz_limpio_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          codigo_producto as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_venta as string,",
				"          costo_adquisicion as string,",
				"          stock_actual as string,",
				"          stock_minimo as string,",
				"          sucursal as string,",
				"          proveedor as string,",
				"          ultima_reposicion as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_producto = trim(nombre_producto),",
				"          categoria = trim(categoria),",
				"          sucursal = trim(sucursal),",
				"          proveedor = trim(proveedor)) ~> derivedColumn1",
				"derivedColumn1 derive(nombre_producto = initCap(regexReplace(nombre_producto,'\\\\s+',' ')),",
				"          categoria = initCap(regexReplace(categoria,'\\\\s+',' '))) ~> derivedColumn2",
				"derivedColumn2 derive(Sucursal = iif(in(['LPZ','la paz','L.P.','LA PAZ','La Paz','Lapaz','LP'],sucursal),'La Paz',sucursal),",
				"          activo = iif(in(['NO','No','no','0','FALSE','false'],activo),'False',iif(in(['si','SI','Si','Sí','sí','1','true','TRUE'], activo), 'True',activo))) ~> derivedColumn3",
				"derivedColumn3 derive(precio_venta = toFloat(regexReplace(toString(precio_venta),'[^0-9.]','')),",
				"          stock_actual = toInteger(stock_actual),",
				"          stock_minimo = toInteger(stock_minimo)) ~> derivedColumn4",
				"derivedColumn4 derive(ultima_reposicion = coalesce(    toDate(ultima_reposicion, 'yyyy-MM-dd'),    toDate(ultima_reposicion, 'yyyy/MM/dd'),    toDate(ultima_reposicion, 'dd/MM/yyyy'),    toDate(ultima_reposicion, 'dd-MM-yyyy'),    toDate(ultima_reposicion, 'dd-MMM-yyyy'),    toDate(ultima_reposicion, 'MMMM dd, yyyy'),    toDate(ultima_reposicion, 'dd \\'de\\' MMMM \\'de\\' yyyy'))) ~> derivedColumn5",
				"derivedColumn5 filter(stock_actual>0 ) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['inventario_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}