{
	"name": "df_venta_lapaz_bronze_silver",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ventas_Lapaz_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_scz_limpio_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_Venta as string,",
				"          Fecha_Venta as string,",
				"          Producto as string,",
				"          Cant as string,",
				"          PrecioUnit as string,",
				"          Sucursal as string,",
				"          Vendedor as string,",
				"          NombreCliente as string,",
				"          EmailCliente as string,",
				"          MetodoPago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(Producto = trim(Producto),",
				"          Cant = trim(Cant),",
				"          Sucursal = trim(Sucursal),",
				"          Vendedor = trim(Vendedor),",
				"          NombreCliente = trim(NombreCliente),",
				"          MetodoPago = trim(MetodoPago),",
				"          EmailCliente = trim(EmailCliente)) ~> derivedColumn1",
				"derivedColumn1 derive(Producto = initCap(regexReplace(Producto,'\\\\s+',' '))) ~> derivedColumn2",
				"derivedColumn2 derive(Sucursal = iif(in(['LPZ','la paz','L.P.','LA PAZ','La Paz','Lapaz','LP'],Sucursal),'La Paz',Sucursal)) ~> derivedColumn3",
				"derivedColumn3 derive(PrecioUnit = toFloat(regexReplace(toString(PrecioUnit),'[^0-9.]','')),",
				"          Cant = toInteger(Cant)) ~> derivedColumn4",
				"derivedColumn4 derive(columna1 = coalesce(\r",
				"    toDate(Fecha_Venta, 'yyyy-MM-dd'),\r",
				"    toDate(Fecha_Venta, 'yyyy/MM/dd'),\r",
				"    toDate(Fecha_Venta, 'dd/MM/yyyy'),\r",
				"    toDate(Fecha_Venta, 'dd-MM-yyyy'),\r",
				"    toDate(Fecha_Venta, 'dd-MMM-yyyy'),\r",
				"    toDate(Fecha_Venta, 'MMMM dd, yyyy'),\r",
				"    toDate(Fecha_Venta, 'dd \\'de\\' MMMM \\'de\\' yyyy')\r",
				")) ~> derivedColumn5",
				"derivedColumn5 filter(Cant>0 && !isNull(PrecioUnit) && !isNull(Fecha_Venta) ) ~> filter1",
				"filter1 select(mapColumn(",
				"          ID_Venta,",
				"          Fecha_Venta,",
				"          Producto,",
				"          Cant,",
				"          PrecioUnit,",
				"          Sucursal,",
				"          Vendedor,",
				"          NombreCliente,",
				"          EmailCliente,",
				"          MetodoPago,",
				"          columna1",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['ventas_lpz_limpio'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}